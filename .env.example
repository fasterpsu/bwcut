# BWCut Studio — Environment Configuration Template
# คัดลอกไฟล์นี้เป็น .env แล้วใส่ API Key ของคุณ

# AI APIs (อย่างน้อย 1 ตัว)
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
ASSEMBLYAI_API_KEY=

# Preferred AI for headlines: gemini หรือ groq
PREFERRED_AI=gemini

# Video & Encoder Settings
DEFAULT_ENCODER=auto
DEFAULT_RESOLUTION=1080p
DEFAULT_BEAUTY=natural
DEFAULT_ENABLE_CTA=true

# Typography & Style
DEFAULT_FONT=Prompt-Bold
TOP_FONT_SIZE=13
BOTTOM_FONT_SIZE=13
TOP_HEADLINE_COLOR=#ffe600
BOTTOM_HEADLINE_COLOR=#ffffff
RANDOM_HEADLINE_COLORS=true
DEFAULT_LINE_SPACING=68

# Output Directory
OUTPUT_DIR=./rendered

# Audio & Silence Detection
SILENCE_THRESHOLD_DB=-20
MIN_SILENCE_DURATION_SEC=0.4
PADDING_SEC=0.05
MAX_CUT_DURATION_SEC=4

# Zoom & Motion Effects
RANDOM_ZOOM=true
ZOOM_LEVELS=1.0, 1.2, 1.3
ENABLE_HOOK_ZOOM=true
HOOK_ZOOM_DURATION_SEC=3
HOOK_ZOOM_SCALE_PERCENT=140

# Notification (ntfy.sh)
NTFY_ENABLED=false
NTFY_TOPIC=bwcut-notifications

# Commercial / Licensing (GAS Endpoint URL)
LICENSE_KEY=
GAS_SERVER_URL=
